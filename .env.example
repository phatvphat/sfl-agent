# Ollama embedding server
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# LanceDB storage path (relative to project root)
LANCEDB_PATH=./data/lancedb

# Sunflower Land frontend repo (main branch only)
SFL_REPO_URL=https://github.com/sunflower-land/sunflower-land.git
SFL_REPO_PATH=./data/sunflower-land
SFL_REPO_BRANCH=main

# Indexing
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_EMBED_CHARS=4000
INDEX_INCLUDE_GLOBS=src/**/*.ts,src/**/*.tsx,docs/**/*.md
# CPU-only (Intel N100…): keep EMBED_CONCURRENCY=1. GPU may try 2–4.
INDEX_BATCH_SIZE=8
EMBED_CONCURRENCY=1
EMBED_NUM_CTX=2048

# sfl.world APIs
SFL_PRICES_API_URL=https://sfl.world/api/v1/prices
SFL_EXCHANGE_API_URL=https://sfl.world/api/v1.1/exchange
SFL_NFTS_API_URL=https://sfl.world/api/v1/nfts

# Cursor SDK (web chat)
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
# composer-2.5: false = standard (rẻ hơn), true = fast (mặc định của Cursor nếu không set params)
CURSOR_MODEL_FAST=false

# Web UI
# Local dev: 127.0.0.1 — deploy LAN: WEB_HOST=0.0.0.0
WEB_HOST=127.0.0.1
WEB_PORT=3847
# Background git pull + incremental index while web runs (default true)
WEB_AUTO_INDEX=true
WEB_AUTO_INDEX_MINUTES=10

# MCP tool payload limits (lower = cheaper agent context)
MCP_SEARCH_LIMIT=4
MCP_SEARCH_MAX_LIMIT=8
MCP_SEARCH_SNIPPET_CHARS=600
MCP_READ_MAX_LINES=200
